# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/ZaloUTE?ssl=true&replicaSet=replica-set-name&authSource=admin&appName=zalute

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
SESSION_SECRET=your_session_secret_key_here_change_in_production

# Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@zaloutee.com
EMAIL_USE_MOCK=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Google Login Configuration
# Use the same OAuth 2.0 Web Client ID as client VITE_GOOGLE_CLIENT_ID.
# Multiple client IDs can be comma-separated if needed.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Google Drive Configuration
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Alternative Google Drive service account credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
