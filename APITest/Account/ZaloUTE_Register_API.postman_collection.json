{
  "info": {
    "name": "ZaloUTE - Register API",
    "description": "Postman collection to test register endpoint /api/auth/register",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register - Success",
      "item": [
        {
          "name": "Register New Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{register_fullname}}\",\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response success true', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Response has email in data', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.data.email).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Register - Duplicate Email",
      "item": [
        {
          "name": "Register Existing Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate User\",\n  \"email\": \"{{register_email}}\",\n  \"password\": \"{{register_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Duplicate email message exists', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(false);",
                  "  pm.expect(data.message).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
