              "id": "f22061f2-030a-448a-b6ef-e16713c3609b",
              "type": "text/javascript",
              "exec": [
                "const generatedEmail = pm.environment.get('generated_register_email');",
                "if (!generatedEmail) {",
                "  throw new Error('generated_register_email is missing. Run the success case first.');",
