{
  "collection": {
    "item": [
      {
        "id": "fe846e3a-76f1-4837-a3a1-83a2f3adc494",
        "name": "1. Register - Success",
        "item": [
          {
            "id": "a577dba7-644b-466c-be4d-a51ea60fbf35",
            "name": "Register New Account",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "register"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"fullName\": \"{{register_fullname}}\",\n  \"email\": \"{{generated_register_email}}\",\n  \"password\": \"{{register_password}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "e3c69356-340b-417d-b650-b13a51c29908",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Status is 201', function () {",
                    "  pm.response.to.have.status(201);",
                    "});",
                    "",
                    "pm.test('Response success true', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.success).to.eql(true);",
                    "});",
                    "",
                    "pm.test('Response message is correct', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.message).to.eql('Đăng ký thành công! Vui lòng xác thực OTP');",
                    "});",
                    "",
                    "pm.test('Response data contains requested email', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.data.email).to.eql(pm.environment.get('generated_register_email'));",
                    "});",
                    "",
                    "pm.test('OTP notice is returned', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.data.message).to.eql('OTP đã được gửi đến email của bạn');",
                    "});"
                  ],
                  "_lastExecutionId": "7f7977f8-4fcb-4dae-a083-c2749fa017b1"
                }
              }
            ]
          }
        ],
        "event": [
          {
            "listen": "prerequest",
            "script": {
              "id": "548b9744-b854-4dda-b7bf-8cfd9e24a17b",
              "type": "text/javascript",
              "exec": [
                "const generatedEmail = `newuser_${Date.now()}@example.com`;",
                "pm.environment.set('generated_register_email', generatedEmail);"
              ],
              "_lastExecutionId": "6d89159d-0ac1-462c-b04a-9fcbb4283c90"
            }
          }
        ]
      },
