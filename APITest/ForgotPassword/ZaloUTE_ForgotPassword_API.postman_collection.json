{
  "info": {
    "name": "ZaloUTE - Forgot Password API",
    "description": "Postman collection to test forgot password endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Request OTP",
      "item": [
        {
          "name": "Request OTP - Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{forgot_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password/request-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password", "request-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const status = pm.response.code;",
                  "pm.environment.set('otp_request_ok', status === 200);",
                  "",
                  "pm.test('Status is 200 or 429', function () {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test('Response success true', function () {",
                  "    pm.expect(data.success).to.eql(true);",
                  "  });",
                  "  pm.test('Response message is generic', function () {",
                  "    pm.expect(data.message).to.eql('Nếu email tồn tại, mã OTP đã được gửi.');",
                  "  });",
                  "  console.log('Request OTP success.');",
                  "} else {",
                  "  console.warn('Rate limit hit. Skipping OTP verification flow.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Reset OTP (Dev)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const otpRequestOk = pm.environment.get('otp_request_ok');",
                  "if (!otpRequestOk) {",
                  "  console.warn('OTP request did not succeed. Skipping OTP fetch.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('reset_otp', data.data.otp);",
                  "}",
                  "pm.test('Dev OTP fetch success in non-production', function () {",
                  "  pm.expect([200, 403, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/dev/reset-otp?email={{forgot_email}}",
              "host": ["{{base_url}}"],
              "path": ["auth", "dev", "reset-otp"],
              "query": [
                {
                  "key": "email",
                  "value": "{{forgot_email}}"
                }
              ]
            }
          }
        },
        {
          "name": "Request OTP - Invalid Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalid-email\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password/request-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password", "request-otp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 or 429', function () {",
                  "  pm.expect([400, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Verify OTP",
      "item": [
        {
          "name": "Verify OTP - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const otpRequestOk = pm.environment.get('otp_request_ok');",
                  "const resetOtp = pm.environment.get('reset_otp');",
                  "if (!otpRequestOk || !resetOtp) {",
                  "  console.warn('OTP not available. Skipping verify OTP step.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response success true', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Reset token returned', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.data.resetToken).to.be.a('string');",
                  "  pm.environment.set('reset_token', data.data.resetToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{forgot_email}}\",\n  \"otp\": \"{{reset_otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Reset Password",
      "item": [
        {
          "name": "Reset Password - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const resetToken = pm.environment.get('reset_token');",
                  "if (!resetToken) {",
                  "  console.warn('reset_token is missing. Run verify OTP first.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response success true', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{reset_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPassword\": \"{{forgot_new_password}}\",\n  \"confirmPassword\": \"{{forgot_confirm_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password/reset-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password", "reset-password"]
            }
          }
        }
      ]
    }
  ]
}
