      {
        "id": "d4ce6854-37fb-432a-8e86-4869e16edfca",
        "name": "2. Verify OTP",
        "item": [
          {
            "id": "243448aa-14a4-4fba-95fd-779687eaafcd",
            "name": "Verify OTP - Success",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "forgot-password",
                  "verify-otp"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{forgot_email}}\",\n  \"otp\": \"{{reset_otp}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "b42e0235-fe66-461f-a7fe-d91cd696a0e8",
                  "type": "text/javascript",
                  "exec": [
                    "const otpRequestOk = pm.environment.get('otp_request_ok');",
                    "const resetOtp = pm.environment.get('reset_otp');",
                    "if (!otpRequestOk || !resetOtp) {",
                    "  console.warn('OTP not available. Skipping verify OTP step.');",
                    "  pm.execution.skipRequest();",
                    "}"
                  ],
                  "_lastExecutionId": "465262d3-fcee-4dc8-b6c6-2e2ae5e526f3"
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "a5673c8a-0236-4cd5-8e23-057cffbdb100",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Status is 200', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test('Response success true', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.success).to.eql(true);",
                    "});",
                    "",
                    "pm.test('Reset token returned', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.data.resetToken).to.be.a('string');",
                    "  pm.environment.set('reset_token', data.data.resetToken);",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
      },
      {
        "id": "cc848d48-03e8-42a0-a9b3-004f174a101d",
        "name": "3. Reset Password",
        "item": [
          {
            "id": "ad39ffaf-0bae-4df8-af72-4e9c14756048",
            "name": "Reset Password - Success",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "forgot-password",
                  "reset-password"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{reset_token}}"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"newPassword\": \"{{forgot_new_password}}\",\n  \"confirmPassword\": \"{{forgot_confirm_password}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "56b01878-409c-45c8-9398-a3bedd9912d2",
                  "type": "text/javascript",
                  "exec": [
                    "const resetToken = pm.environment.get('reset_token');",
                    "if (!resetToken) {",
                    "  console.warn('reset_token is missing. Run verify OTP first.');",
                    "  pm.execution.skipRequest();",
                    "}"
                  ],
                  "_lastExecutionId": "80b038f3-9804-4ee7-a84a-7127531fd89b"
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "0e33a9cd-0c8e-41c3-b4fc-86e94ed7dc48",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Status is 200', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test('Response success true', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.success).to.eql(true);",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
