      {
        "id": "e0ae75ea-d31e-457e-a570-1c87900e30ef",
        "name": "2. Verify OTP",
        "item": [
          {
            "id": "818fccf7-34b3-4e81-82d7-fa6b1d02a975",
            "name": "Verify OTP - Success",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "forgot-password",
                  "verify-otp"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{forgot_email}}\",\n  \"otp\": \"{{reset_otp}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "2034eb15-750c-40af-be2c-ce56d5f0dd09",
                  "type": "text/javascript",
                  "exec": [
                    "const otpRequestOk = pm.environment.get('otp_request_ok');",
                    "const resetOtp = pm.environment.get('reset_otp');",
                    "if (!otpRequestOk || !resetOtp) {",
                    "  console.warn('OTP not available. Skipping verify OTP step.');",
                    "  pm.execution.skipRequest();",
                    "}"
                  ],
                  "_lastExecutionId": "8f877aa7-d2e0-4d55-a8fe-80473193e3e9"
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "b09342be-e85a-442d-8d48-95ea5f6b5aa8",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Status is 200', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test('Response success true', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.success).to.eql(true);",
                    "});",
                    "",
                    "pm.test('Reset session redirect returned', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.data.redirectUrl).to.eql('/reset-password');",
                    "  pm.environment.set('reset_session_ok', 'true');",
                    "  pm.environment.set('reset_token', data.data.resetToken || '');",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
      },
      {
        "id": "42dfc715-04e7-469f-9530-51ff2dfa0a16",
        "name": "3. Reset Password",
        "item": [
          {
            "id": "6a7488e5-4d8a-4912-a8ce-225404a83f99",
            "name": "Reset Password - Success",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "forgot-password",
                  "reset-password"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Authorization",
                  "value": "Bearer {{reset_token}}"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"newPassword\": \"{{forgot_new_password}}\",\n  \"confirmPassword\": \"{{forgot_confirm_password}}\",\n  \"resetToken\": \"{{reset_token}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "b438aadf-f2d8-4fe6-a343-a6d7cb3d3c08",
                  "type": "text/javascript",
                  "exec": [
                    "const resetSessionOk = pm.environment.get('reset_session_ok') === 'true';",
                    "const resetToken = pm.environment.get('reset_token');",
                    "if (!resetSessionOk) {",
                    "  console.warn('reset session is missing. Run verify OTP first.');",
                    "  pm.execution.skipRequest();",
                    "}",
                    "if (!resetToken) {",
                    "  console.warn('reset token missing. Run verify OTP first.');",
                    "  pm.execution.skipRequest();",
                    "}"
                  ],
                  "_lastExecutionId": "65ccd53e-792d-4ffa-9533-26d73ed68486"
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "0f37e827-498b-4257-9c6b-1d75f90c911d",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('Status is 200', function () {",
                    "  pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test('Response success true', function () {",
                    "  var data = pm.response.json();",
                    "  pm.expect(data.success).to.eql(true);",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
      }
