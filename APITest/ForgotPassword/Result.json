{
  "collection": {
    "item": [
      {
        "id": "5ba04306-f2c2-4f88-bb19-331518ebc13f",
        "name": "1. Request OTP",
        "item": [
          {
            "id": "d1575f75-60af-4d4c-a565-86aef8319202",
            "name": "Request OTP - Success",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "forgot-password",
                  "request-otp"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{forgot_email}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "22b16ca7-41ca-43d3-9eea-a046547f63f5",
                  "type": "text/javascript",
                  "exec": [
                    "const status = pm.response.code;",
                    "pm.environment.set('otp_request_ok', status === 200);",
                    "",
                    "pm.test('Status is 200, 400, 404, or 429', function () {",
                    "  pm.expect([200, 400, 404, 429]).to.include(status);",
                    "});",
                    "",
                    "if (status === 200) {",
                    "  const data = pm.response.json();",
                    "  pm.test('Response success true', function () {",
                    "    pm.expect(data.success).to.eql(true);",
                    "  });",
                    "  pm.test('Response message is generic', function () {",
                    "    pm.expect(data.message).to.eql('Nếu email tồn tại, mã OTP đã được gửi.');",
                    "  });",
                    "  console.log('Request OTP success.');",
                    "} else if (status === 404) {",
                    "  const data = pm.response.json();",
                    "  pm.test('Account not found message', function () {",
                    "    pm.expect(['Tài khoản không tồn tại.', 'Account not found.']).to.include(data.message);",
                    "  });",
                    "  console.warn('Account not found.');",
                    "} else if (status === 429) {",
                    "  console.warn('Rate limit hit. Skipping OTP verification flow.');",
                    "} else {",
                    "  console.warn('OTP request failed (account inactive or invalid). Skipping OTP verification flow.');",
                    "}"
                  ],
                  "_lastExecutionId": "e8f235f1-4f8e-43ff-9539-d9402dae0c43"
                }
              }
            ]
          },
          {
            "id": "f6aee637-8d6f-4135-abb3-84a2db3f2e6c",
            "name": "Get Reset OTP (Dev)",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "dev",
                  "reset-otp"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [
                  {
                    "key": "email",
                    "value": "{{forgot_email}}"
                  }
                ],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "2e1b14a3-e80b-41fa-93c6-e998f36b3355",
                  "type": "text/javascript",
                  "exec": [
                    "const otpRequestOk = pm.environment.get('otp_request_ok');",
                    "if (!otpRequestOk) {",
                    "  console.warn('OTP request did not succeed. Skipping OTP fetch.');",
                    "  pm.execution.skipRequest();",
                    "}"
                  ],
                  "_lastExecutionId": "f332117d-ca09-4060-b576-57d5ca8119c7"
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "8726e073-8001-45f8-ab91-100601e797a7",
                  "type": "text/javascript",
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  const data = pm.response.json();",
                    "  pm.environment.set('reset_otp', data.data.otp);",
                    "}",
                    "pm.test('Dev OTP fetch success in non-production', function () {",
                    "  pm.expect([200, 403, 404]).to.include(pm.response.code);",
                    "});"
                  ]
                }
              }
            ]
          },
