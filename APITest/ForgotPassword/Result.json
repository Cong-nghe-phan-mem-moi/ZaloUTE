{
  "collection": {
    "item": [
      {
        "id": "8bc1e9eb-3330-4250-b009-b7876b88ebcc",
        "name": "1. Request OTP",
        "item": [
          {
            "id": "89460d19-2b2c-4f09-a600-b605913843bc",
            "name": "Request OTP - Success",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "forgot-password",
                  "request-otp"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{forgot_email}}\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "4cea9eee-e308-4f8e-a25e-502438e8aee7",
                  "type": "text/javascript",
                  "exec": [
                    "const status = pm.response.code;",
                    "pm.environment.set('otp_request_ok', status === 200);",
                    "",
                    "pm.test('Status is 200 or 429', function () {",
                    "  pm.expect([200, 429]).to.include(status);",
                    "});",
                    "",
                    "if (status === 200) {",
                    "  const data = pm.response.json();",
                    "  pm.test('Response success true', function () {",
                    "    pm.expect(data.success).to.eql(true);",
                    "  });",
                    "  pm.test('Response message is generic', function () {",
                    "    pm.expect(data.message).to.eql('Nếu email tồn tại, mã OTP đã được gửi.');",
                    "  });",
                    "  console.log('Request OTP success.');",
                    "} else {",
                    "  console.warn('Rate limit hit. Skipping OTP verification flow.');",
                    "}"
                  ],
                  "_lastExecutionId": "64c70319-f494-4ed1-9b68-8a04c186a7bc"
                }
              }
            ]
          },
          {
            "id": "328de774-5596-453d-9ab1-3145d6a5d7d8",
            "name": "Get Reset OTP (Dev)",
            "request": {
              "url": {
                "path": [
                  "auth",
                  "dev",
                  "reset-otp"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [
                  {
                    "key": "email",
                    "value": "{{forgot_email}}"
                  }
                ],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "f0ff4cb4-ae6f-468e-abd1-11bef7ccad87",
                  "type": "text/javascript",
                  "exec": [
                    "const otpRequestOk = pm.environment.get('otp_request_ok');",
                    "if (!otpRequestOk) {",
                    "  console.warn('OTP request did not succeed. Skipping OTP fetch.');",
                    "  pm.execution.skipRequest();",
                    "}"
                  ],
                  "_lastExecutionId": "84849a92-b71b-4178-9f75-1c76d83f692b"
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "91fd23f7-3367-4301-a84d-726902b565d1",
                  "type": "text/javascript",
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  const data = pm.response.json();",
                    "  pm.environment.set('reset_otp', data.data.otp);",
                    "}",
                    "pm.test('Dev OTP fetch success in non-production', function () {",
                    "  pm.expect([200, 403, 404]).to.include(pm.response.code);",
                    "});"
                  ]
                }
              }
            ]
          },
