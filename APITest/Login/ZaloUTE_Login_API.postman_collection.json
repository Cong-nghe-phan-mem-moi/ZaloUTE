            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "console.log('Test: Login - Unverified Account');",
                            "console.log('Status Code: ' + pm.response.code);",
                            "console.log('Response Body: ' + pm.response.text());",
                            "",
                            "pm.test('Status code is 400 (Unverified)', function() {",
                            "    pm.expect(pm.response.code).to.equal(400);",
                            "});",
                            "",
                            "pm.test('Response has success: false', function() {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.equal(false);",
                            "});",
                            "",
                            "pm.test('Error message about verification', function() {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.message).to.include('xác thực');",
                            "});"
                        ]
                    }
                }
            ]
        },
