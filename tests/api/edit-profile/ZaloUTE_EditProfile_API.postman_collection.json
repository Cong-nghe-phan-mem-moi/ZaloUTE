                  "pm.test('Status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Only name is updated', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.fullName).to.equal('Nguyễn Văn B');",
                  "});"
