      ]
    },
    {
      "name": "4. Edit Profile - Validation Errors (400)",
      "item": [
        {
          "name": "Invalid Email Format",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              },
              {
                "key": "Content-Type",
